# ==============================================================================
# NightWatch Agent Sandbox Dockerfile
# node:20-bookworm-slim (Debian 기반)
# ==============================================================================

FROM node:20-bookworm-slim

# 1. 메타데이터
LABEL maintainer="kimpossible-TY"
LABEL description="NightWatch Project Autonomous Development Sandbox (Node-based)"

# 2. 비대화형 모드 설정
ENV DEBIAN_FRONTEND=noninteractive

# 3. 필수 패키지 설치 (Python 포함)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    xz-utils \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    unzip \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# 4. OpenClaw CLI 전역 설치 및 검증
RUN npm install -g openclaw \
    && openclaw --version

# 5. Typst 설치
RUN curl -L -o /tmp/typst.tar.xz \
    https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.xz \
    && mkdir -p /tmp/typst-bin \
    && tar -xf /tmp/typst.tar.xz -C /tmp/typst-bin --strip-components=1 \
    && mv /tmp/typst-bin/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst*

# 6. 작업 디렉토리 설정
WORKDIR /workspace

# 7. Python 가상 환경 설정
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 8. 기본적인 Python 패키지 설치
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
    pytest \
    pytest-cov \
    flake8 \
    mypy \
    requests

# 9. 소스 루트 마운트 준비 (docker-compose 반영)
ENV PYTHONPATH=/workspace

# 10. 컨테이너 유지용 기본 명령어
CMD ["tail", "-f", "/dev/null"]
