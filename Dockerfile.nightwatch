# ==============================================================================
# NightWatch Agent Sandbox Dockerfile
# Ubuntu 24.04 (Noble Numbat) 기반
# ==============================================================================

FROM ubuntu:24.04

# 1. 메타데이터
LABEL maintainer="kimpossible-TY"
LABEL description="NightWatch Project Autonomous Development Sandbox"

# 2. 비대화형 모드 설정
ENV DEBIAN_FRONTEND=noninteractive

# 3. 필수 패키지 설치
# git, curl, python3, pip, nodejs, npm 등
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    xz-utils \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    unzip \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# 4. Node.js 20.x 설치 (OpenClaw용)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# PATH 설정 (npm global 및 venv 경로 포함)
ENV PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games:$PATH"

# 5. OpenClaw CLI 전역 설치
RUN npm install -g openclaw && npx openclaw --version

# 6. Typst 설치 (최신 릴리즈 추출)
RUN curl -L -o /tmp/typst.tar.xz \
    https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.xz \
    && mkdir -p /tmp/typst-bin \
    && tar -xf /tmp/typst.tar.xz -C /tmp/typst-bin --strip-components=1 \
    && mv /tmp/typst-bin/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst*

# 7. 작업 디렉토리 설정
WORKDIR /workspace

# 8. Python 가상 환경 설정
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
# venv bin을 PATH에 추가 (이미 위에서 정의된 PATH에 덧붙임)
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 9. 기본적인 Python 패키지 설치
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
    pytest \
    pytest-cov \
    flake8 \
    mypy \
    requests

# 10. OpenClaw 에이전트 설정 및 소스 루트 마운트 준비
# (docker-compose에서 실제 소스가 마운트됨)
ENV PYTHONPATH=/app

# 11. 컨테이너 유지용 기본 명령어 (docker compose run 으로 명령 전달 시 무시됨)
CMD ["tail", "-f", "/dev/null"]
