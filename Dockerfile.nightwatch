# ==============================================================================
# Project NightWatch — AI Agent Sandbox
# Ubuntu 24.04 기반, tests/ 디렉터리는 read-only 마운트로 외부에서 보호됨
# ==============================================================================

FROM ubuntu:24.04

# 비대화형 설치 모드
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

# 1. 시스템 패키지
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    xz-utils \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# 2. Typst 설치 (최신 릴리즈)
RUN curl -L -o /tmp/typst.tar.xz \
    https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.xz \
    && tar -xf /tmp/typst.tar.xz -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst*

# 3. Python 패키지 (requirements.txt가 있을 때만 설치)
WORKDIR /workspace
RUN python3 -m venv /workspace/.venv
ENV PATH="/workspace/.venv/bin:$PATH"

# 4. pip 최신화 (requirements는 컨테이너 기동 시 별도 설치)
RUN pip install --upgrade pip

# 5. 작업 디렉터리 설정
WORKDIR /workspace

# 진입점
CMD ["/bin/bash"]
